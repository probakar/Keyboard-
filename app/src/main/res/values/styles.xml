<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomBoard.Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="CustomBoard.Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="CustomBoard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/settings_corner</item>
        <item name="cardElevation">1dp</item>
        <item name="android:layout_margin">@dimen/settings_card_margin</item>
    </style>

    <style name="CustomBoard.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="CustomBoard.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="CustomBoard.Button.Text" parent="Widget.Material3.Button.TextButton" />

    <style name="CustomBoard.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CustomBoard.Toolbar.Icon">
        <item name="android:layout_width">@dimen/toolbar_height</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:padding">@dimen/toolbar_item_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

</resources>
