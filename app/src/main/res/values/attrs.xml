<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="KeyboardView">
        <attr name="keyBackgroundColor" format="color" />
        <attr name="keyTextColor" format="color" />
        <attr name="keyCornerRadius" format="dimension" />
        <attr name="keyTextSize" format="dimension" />
        <attr name="showKeyBorders" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ColorPickerPreference">
        <attr name="defaultColorValue" format="color" />
    </declare-styleable>

    <declare-styleable name="SeekBarWithValuePreference">
        <attr name="valueSuffix" format="string" />
        <attr name="minValue" format="integer" />
        <attr name="maxValue" format="integer" />
        <attr name="stepValue" format="integer" />
    </declare-styleable>
</resources>
