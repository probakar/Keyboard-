<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:orientation="vertical">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/drag_handle_height"
            android:background="@drawable/bg_drag_handle"
            android:contentDescription="@string/cd_drag_keyboard"
            android:visibility="gone" />

        <com.customboard.keyboard.widgets.ToolbarView
            android:id="@+id/toolbar_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height" />

        <com.customboard.keyboard.widgets.CandidateView
            android:id="@+id/candidate_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/candidate_height" />

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="@dimen/keyboard_height">

            <com.customboard.keyboard.widgets.KeyboardView
                android:id="@+id/keyboard_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/panel_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>
</FrameLayout>
