<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptic feedback on key press -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Optional: AI features, GIF search and online translation -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: voice typing -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional: contact name suggestions (runtime requested, can be denied) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Optional: app-lock for the settings screen -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <!-- Android 11+ package visibility -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".CustomBoardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CustomBoard"
        tools:targetApi="31">

        <!-- ============================================================= -->
        <!--  The keyboard itself (InputMethodService)                      -->
        <!-- ============================================================= -->
        <service
            android:name=".service.CustomBoardIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- ============================================================= -->
        <!--  Setup wizard (launcher)                                      -->
        <!-- ============================================================= -->
        <activity
            android:name=".settings.SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CustomBoard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================= -->
        <!--  Settings                                                     -->
        <!-- ============================================================= -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:launchMode="singleTop"
            android:parentActivityName=".settings.SetupActivity"
            android:theme="@style/Theme.CustomBoard">
            <intent-filter>
                <action android:name="com.customboard.keyboard.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Visual theme gallery -->
        <activity
            android:name=".settings.ThemePickerActivity"
            android:exported="false"
            android:label="@string/settings_theme"
            android:parentActivityName=".settings.SettingsActivity"
            android:theme="@style/Theme.CustomBoard" />

        <!-- Drag-and-drop toolbar editor -->
        <activity
            android:name=".settings.ToolbarCustomizeActivity"
            android:exported="false"
            android:label="@string/toolbar_customize"
            android:parentActivityName=".settings.SettingsActivity"
            android:theme="@style/Theme.CustomBoard" />

        <!-- Personal dictionary and blocked words -->
        <activity
            android:name=".settings.PersonalDictionaryActivity"
            android:exported="false"
            android:label="@string/dictionary_title"
            android:parentActivityName=".settings.SettingsActivity"
            android:theme="@style/Theme.CustomBoard" />

        <!-- Transparent helper used by the keyboard to request runtime permissions -->
        <activity
            android:name=".settings.PermissionRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@style/Theme.CustomBoard.Transparent" />

        <!-- Quick Settings tile: toggle incognito typing without opening the app -->
        <service
            android:name=".privacy.IncognitoTileService"
            android:exported="true"
            android:icon="@drawable/ic_incognito"
            android:label="@string/incognito_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!-- Shares downloaded GIFs with the target app through a content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Spell checker service used by other apps / the system -->
        <service
            android:name=".autocorrect.CustomBoardSpellCheckerService"
            android:exported="true"
            android:label="@string/spell_checker_name"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>
    </application>

</manifest>
